# 默认忽略 Pi 的全部本机运行数据，仅显式纳入可同步的配置文件。
/*

# 可同步的全局配置
!/.gitignore
!/AGENTS.md
!/settings.json.bak

# 自定义资源
!/prompts/
!/prompts/**
!/extensions/
!/extensions/**
!/bin/
!/bin/**
!/docs/
!/docs/orca-browser-guide.md
!/plan/
!/plan/**

# 以下文件即使未来修改了上方规则也不得提交：认证凭据、会话、运行状态与包安装缓存。
/auth.json
/settings.json
/codex-accounts.json
/trust.json
/sessions/
/state/
/observability/
/npm/
/git/

# Orca 扩展脚本（本机专用，不入库）
/extensions/orca-agent-status.ts
/extensions/orca-prefill.ts
/extensions/orca-titlebar-spinner.ts
